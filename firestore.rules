rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // DINING MANAGEMENT SYSTEM — Cloud Firestore Security Rules
    //
    // CRITICAL SECURITY ENFORCEMENT:
    // 1. Authorized Admin UID has full access across all operational collections.
    // 2. Strict UID validation: Only request.auth.uid == 'iSOfrQnFU2gxQekEFUOjSOSeEi82'
    // 3. Public visitors have READ-ONLY access strictly and exclusively to
    //    whitelisted 'public_portal/meta' and 'public_portal/{monthId}' documents.
    // 4. Strict month format validation: YYYY-MM where MM is 01–12.
    // 5. Strict field allowlist: Prevents any sensitive or unexpected fields from
    //    being published to public portal documents.
    // 6. Delete operations are separated from create/update so request.resource.data
    //    is never evaluated on deletion.
    // 7. Unauthenticated users cannot write, update, or delete any document.
    // 8. All private collections (members, mealEntries, expenses, deposits,
    //    categories, managers, dailyClosures, settings, appMetadata) are Admin-only.
    //
    // Authorized Admin UID: iSOfrQnFU2gxQekEFUOjSOSeEi82
    // =========================================================================

    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.uid == 'iSOfrQnFU2gxQekEFUOjSOSeEi82';
    }

    function isValidMonthId(monthId) {
      return monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // Strict field allowlist & nested type validation for public_portal/meta
    function isValidMetaDoc() {
      let data = request.resource.data;
      let hasAllowedKeys = data.keys().hasOnly([
        'messName',
        'institutionName',
        'hallName',
        'currencySymbol',
        'activeMonth',
        'availableMonths',
        'lastPublishedAt',
        'currentManager',
        'availableManagers'
      ]);

      let validCurrentManager = !('currentManager' in data) ||
        data.currentManager == null ||
        (
          data.currentManager is map &&
          data.currentManager.keys().hasOnly([
            'id',
            'managerName',
            'assignmentDate',
            'status',
            'resignationDate',
            'totalMeals',
            'totalMarketExpenses',
            'mealRate',
            'managerFeePerMeal',
            'totalManagerFee'
          ]) &&
          data.currentManager.managerName is string &&
          data.currentManager.assignmentDate is string &&
          data.currentManager.status in ['active', 'resigned', 'Active', 'Resigned'] &&
          data.currentManager.totalMeals is number &&
          data.currentManager.totalMarketExpenses is number &&
          data.currentManager.mealRate is number &&
          data.currentManager.managerFeePerMeal is number &&
          data.currentManager.totalManagerFee is number &&
          (
            !('resignationDate' in data.currentManager) ||
            data.currentManager.resignationDate == null ||
            data.currentManager.resignationDate is string
          )
        );

      let validAvailableManagers = !('availableManagers' in data) ||
        data.availableManagers == null ||
        data.availableManagers is list;

      return hasAllowedKeys && validCurrentManager && validAvailableManagers;
    }

    // Strict field allowlist for public_portal/{monthId}
    // Operational monthly data only. No duplicated manager assignment summary.
    function isValidMonthDoc() {
      return request.resource.data.keys().hasOnly([
        'month',
        'summary',
        'dailyMealSummaries',
        'expenses',
        'members',
        'memberDailyMeals',
        'publishedAt'
      ]);
    }

    // 1. PUBLIC PORTAL COLLECTION:
    // Whitelisted documents only. No broad wildcard matching.

    // A. Meta Document: Public read-only; Admin create/update with allowlist; Admin delete
    match /public_portal/meta {
      allow read: if true;
      allow create, update: if isAuthorizedAdmin() && isValidMetaDoc();
      allow delete: if isAuthorizedAdmin();
    }

    // B. Monthly Documents: Public read-only for valid YYYY-MM (01-12);
    // Admin create/update with month format & allowlist; Admin delete
    match /public_portal/{monthId} {
      allow read: if isValidMonthId(monthId);
      allow create, update: if isAuthorizedAdmin() && isValidMonthId(monthId) && isValidMonthDoc();
      allow delete: if isAuthorizedAdmin();
    }

    // 2. STRICTLY PRIVATE COLLECTIONS:
    // Only authorized Admin UID may read, create, update, or delete.
    // Public unauthenticated access is completely blocked with permission-denied.
    match /members/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /mealEntries/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /expenses/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /deposits/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /categories/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /managers/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /dailyClosures/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /settings/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /appMetadata/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}
