rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // DINING MANAGEMENT SYSTEM — Cloud Firestore Security Rules
    //
    // CRITICAL SECURITY ENFORCEMENT:
    // 1. Authorized Admin UID has full read and write access across all collections.
    // 2. Unauthenticated / public visitors have READ-ONLY access strictly and
    //    exclusively to the 'public_portal' collection and its documents.
    // 3. Unauthenticated visitors are strictly DENIED from reading or writing
    //    any private collection (members, mealEntries, expenses, deposits,
    //    categories, managers, dailyClosures, settings, appMetadata).
    // 4. Nobody except the authorized Admin can create, modify, or delete in 'public_portal'.
    //
    // Authorized Admin UID: iSOfrQnFU2gxQekEFUOjSOSeEi82
    // =========================================================================

    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.uid == 'iSOfrQnFU2gxQekEFUOjSOSeEi82' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    // 1. PUBLIC PORTAL COLLECTION:
    // Read: Whitelisted to meta document and validated YYYY-MM month documents only.
    // Write: Strictly restricted to authorized Admin UID with field-level sanitization enforcement.
    match /public_portal/meta {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /public_portal/{monthId} {
      // Whitelist only valid YYYY-MM document keys (e.g., 2026-03)
      allow read: if monthId.matches('^[0-9]{4}-[0-9]{2}$');

      // Admin write with field-level sanitization enforcement:
      // Absolutely forbids private financial keys from being stored in public_portal
      allow write: if isAuthorizedAdmin()
        && monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && !request.resource.data.keys().hasAny([
          'deposits', 'totalDeposits', 'due', 'totalDue',
          'advance', 'totalAdvance', 'phone', 'personalNotes',
          'paymentHistory'
        ]);
    }

    // 2. STRICTLY PRIVATE COLLECTIONS:
    // Only authorized Admin UID may read or write.
    // Public unauthenticated access is completely blocked with permission-denied.
    match /members/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /mealEntries/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /expenses/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /deposits/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /categories/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /managers/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /dailyClosures/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /settings/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /appMetadata/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // Global default catch-all: deny all unless authorized admin
    match /{document=**} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}
