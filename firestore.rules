rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // DINING MANAGEMENT SYSTEM — Cloud Firestore Security Rules
    //
    // CRITICAL SECURITY ENFORCEMENT:
    // 1. Authorized Admin UID has full read and write access across all collections.
    // 2. Unauthenticated / public visitors have READ-ONLY access strictly and
    //    exclusively to approved 'public_portal' metadata and month documents.
    // 3. Unauthenticated visitors are strictly DENIED from reading or writing
    //    any private collection (members, mealEntries, expenses, deposits,
    //    categories, managers, dailyClosures, settings, appMetadata).
    // 4. Public visitors cannot write, update, or delete ANY document.
    // 5. Writes to 'public_portal' are strictly restricted to the authorized Admin
    //    and MUST NOT contain any private financial or personal fields.
    //
    // Authorized Admin UID: iSOfrQnFU2gxQekEFUOjSOSeEi82
    // =========================================================================

    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.uid == 'iSOfrQnFU2gxQekEFUOjSOSeEi82' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    // Helper: Validates that payload contains NO private financial or personal member fields
    function hasNoPrivateFields() {
      return !request.resource.data.keys().hasAny([
        'deposits',
        'totalDeposits',
        'due',
        'totalDue',
        'advance',
        'totalAdvance',
        'phone',
        'personalNotes',
        'paymentHistory'
      ]);
    }

    // 1. PUBLIC PORTAL COLLECTION:
    // Whitelisted documents only. No broad wildcard matching.

    // A. Meta Document:
    // Public read-only; Admin write with private-field validation
    match /public_portal/meta {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && hasNoPrivateFields();
    }

    // B. Monthly Documents:
    // Public read-only for valid YYYY-MM (01-12);
    // Admin write with valid month range format and private-field validation
    match /public_portal/{monthId} {
      allow read: if monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      allow write: if isAuthorizedAdmin()
        && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && hasNoPrivateFields();
    }

    // 2. STRICTLY PRIVATE COLLECTIONS:
    // Only authorized Admin UID may read or write.
    // Public unauthenticated access is completely blocked with permission-denied.
    match /members/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /mealEntries/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /expenses/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /deposits/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /categories/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /managers/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /dailyClosures/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /settings/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /appMetadata/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}
