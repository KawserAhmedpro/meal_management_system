# Firebase Web Configuration for DINING MANAGEMENT SYSTEM
# Obtain these values from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Authorized Admin UID
# Obtain this from Firebase Console -> Authentication -> Users (after creating your Admin account)
# Only this UID will be permitted to access and modify the mess database
VITE_FIREBASE_ADMIN_UID=your-admin-uid-here
